# Public site URL used for canonical links, metadata and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Projects API write access (/api/projects)
# -----------------------------------------------------------------------------
# Server-side only. The collection endpoints (GET /api/projects and
# GET /api/projects/:slug) are public and need no configuration.
# Create/update/delete require "Authorization: Bearer <ADMIN_API_TOKEN>".
# When this is unset, write endpoints answer 503 admin_disabled instead of
# accepting anything — the API never pretends to be protected when it is not.
# Use a long random string, e.g.: openssl rand -hex 32
ADMIN_API_TOKEN=

# -----------------------------------------------------------------------------
# Contact form email delivery (Resend HTTP API)
# -----------------------------------------------------------------------------
# Server-side only. Never add a NEXT_PUBLIC_ prefix to this key.
RESEND_API_KEY=

# Where contact form inquiries are delivered. Defaults to saifulislamnyt@gmail.com.
CONTACT_TO_EMAIL=

# Sender identity shown in the inbox. Defaults to: Portfolio Website <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# Optional fixed reply-to address for outgoing inquiries.
# When empty, the visitor's own email address from the form is used as reply-to.
CONTACT_REPLY_TO=

# -----------------------------------------------------------------------------
# Contact form behaviour
# -----------------------------------------------------------------------------
# Without RESEND_API_KEY the form never pretends to succeed: it reports status
# "unconfigured" to the visitor, explains that nothing was sent, and offers the
# saifulislamnyt@gmail.com mailto link plus the WhatsApp link instead.
# With RESEND_API_KEY set, a successful provider response shows a thank-you
# message; a provider failure shows an honest error with the mailto fallback,
# and the failure is logged server-side without printing any secrets.
#
# Server-side spam protection (best effort, in-memory, per server instance):
#   * honeypot field named "company_website" that must stay empty,
#   * hidden timestamp requiring at least 3 seconds to complete the form,
#   * sliding window rate limit of 3 submissions per 10 minutes, keyed by
#     client IP (x-forwarded-for, falling back to x-real-ip) and by submitter
#     email address — both keys must pass, counters are in-memory and reset
#     when the server restarts or a new instance starts. When the proxy header
#     is missing, every request shares the same "unknown" IP bucket.
